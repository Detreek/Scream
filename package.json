{
  "name": "scream-icon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "vite:preview": "vite preview",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "dev": "concurrently \"npm run vite:dev\" \"npm run electron:dev\"",
    "electron": "electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:dist": "electron-builder",
    "electron:dist:win": "electron-builder --win",
    "electron:dist:mac": "electron-builder --mac",
    "electron:dist:linux": "electron-builder --linux",
    "electron:dist:all": "electron-builder --mac --win --linux"
  },
  "dependencies": {
    "eventemitter3": "^5.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-use-websocket": "^4.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  }
}
